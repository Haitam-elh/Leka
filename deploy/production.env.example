# Production, by name. Copy to production.env ON THE BOX and fill it in
# there — this file is the documentation, production.env holds the secrets
# and is never committed (see deploy/.gitignore).
#
# Every LEKA_* variable the application reads is documented in
# docs/configuration.md. The first four below are read by the compose file
# and by Caddy, never by the application.

# ── what the compose file needs ──────────────────────────────────────────────
# Both written by deploy.sh on every deployment; leave them empty here.
LEKA_REGISTRY=
LEKA_RELEASE=
# Every name must point at this box in DNS (an A record each) BEFORE Caddy
# is told about it: it asks Let's Encrypt for their certificates on its own.
# leka-core.com is the site and the application together; the API has its
# own name. The aliases — what served the application before — redirect to
# it, path kept. See docs/deployment.md, "leka-core.com".
LEKA_APP_DOMAIN=leka-core.com
LEKA_APP_ALIASES=www.leka-core.com, app.leka-core.com
LEKA_API_DOMAIN=api.leka-core.com

# ── the database: Amazon RDS for PostgreSQL, eu-central-1 ────────────────────
# postgresql+asyncpg://leka:<password>@<endpoint>:5432/leka?ssl=require
#   <endpoint>    RDS console → the instance → Connectivity & security
#   ?ssl=require  the connection is encrypted; RDS refuses it otherwise
# The instance is NOT publicly accessible: only this box's security group
# may reach port 5432. See docs/deployment.md, "The database".
LEKA_DATABASE_URL=

# ── secrets ──────────────────────────────────────────────────────────────────
# `python -c "import secrets; print(secrets.token_urlsafe(64))"`
LEKA_SECRET_KEY=
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
LEKA_ENCRYPTION_KEYS=["..."]

# ── object storage: Amazon S3, eu-central-1 ──────────────────────────────────
# A real region, not "auto" — that value is Cloudflare R2's. Production
# refuses to start with LEKA_OBJECT_STORE=local.
LEKA_OBJECT_STORE=s3
LEKA_S3_BUCKET=
LEKA_S3_REGION=eu-central-1
LEKA_S3_ENDPOINT_URL=
LEKA_S3_ACCESS_KEY_ID=
LEKA_S3_SECRET_ACCESS_KEY=

# ── e-mail: the OVH mailbox ─────────────────────────────────────────────────
# Without these the API REFUSES TO START: a sign-up whose link goes to a log
# nobody reads is what met the first demo. The From address must be the
# mailbox that signs in — OVH silently drops anything else, so the API
# refuses a mismatch too. Test by hand, errors in the open:
#   docker compose -f docker-compose.production.yml --env-file production.env \
#     exec api python -m leka.identity.email --test you@example.com
LEKA_EMAIL_FROM=LEKA <support@leka-core.com>
LEKA_SMTP_HOST=ssl0.ovh.net
LEKA_SMTP_PORT=465
LEKA_SMTP_USE_SSL=true
LEKA_SMTP_USERNAME=support@leka-core.com
# The mailbox password: here, on the box, and nowhere else.
LEKA_SMTP_PASSWORD=

# Every link in an email is built on this. https, no trailing slash.
LEKA_WEB_URL=https://leka-core.com

# ── language models (LEKA-394) ───────────────────────────────────────────────
# Without a key the platform works, and what needs a model says so. Gemini
# 3.8 Flash is the default; a project with billing on (the free tier's
# prompts may be used by Google). Mistral answers when Gemini does not.
LEKA_LLM_PROVIDER=google
LEKA_LLM_MODEL=gemini-3.8-flash
LEKA_LLM_FALLBACKS=mistral:mistral-large-latest
LEKA_GOOGLE_API_KEY=
LEKA_MISTRAL_API_KEY=

# ── monitoring ───────────────────────────────────────────────────────────────
# Empty means off. Sentry project on the EU region.
LEKA_SENTRY_DSN=

# ── the browser contract ─────────────────────────────────────────────────────
# HTTPS everywhere, so the session cookie is Secure; the web app is the one
# origin allowed to call the API with it. See ADR 009.
LEKA_SESSION_COOKIE_SECURE=true
LEKA_CORS_ORIGINS=["https://leka-core.com"]
LEKA_LOG_FORMAT=json
