# The staging environment, by name. Copy to staging.env ON THE BOX and fill
# it in there — this file is the documentation, staging.env is the secret and
# is never committed (see deploy/.gitignore).
#
# Every LEKA_* variable the application reads is documented in
# docs/configuration.md. The first three below are read by the compose file
# and by Caddy, never by the application.

# ── what the compose file needs ──────────────────────────────────────────────
# Both written by deploy.sh on every deployment; leave them empty here. The
# image is lower case — an image reference must be, and the repository is
# not. Never `latest`: see the comment in docker-compose.staging.yml.
LEKA_IMAGE=
LEKA_RELEASE=
# Leave empty until DNS points here; Caddy then serves plain HTTP on :80.
# Once set, Caddy obtains the certificate itself on first start.
LEKA_STAGING_DOMAIN=

# ── the database: Neon, already provisioned ──────────────────────────────────
# Project `Leka`, PostgreSQL 16, aws-eu-central-1. Use the POOLED connection
# string. Free plan: 6 hours of history, see docs/runbook.md.
LEKA_DATABASE_URL=

# ── secrets ──────────────────────────────────────────────────────────────────
# `python -c "import secrets; print(secrets.token_urlsafe(64))"`
LEKA_SECRET_KEY=
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
LEKA_ENCRYPTION_KEYS=["..."]

# ── object storage: Amazon S3, eu-central-1 ──────────────────────────────────
# A real region, not "auto" — that value is Cloudflare R2's.
LEKA_OBJECT_STORE=s3
LEKA_S3_BUCKET=
LEKA_S3_REGION=eu-central-1
LEKA_S3_ENDPOINT_URL=
LEKA_S3_ACCESS_KEY_ID=
LEKA_S3_SECRET_ACCESS_KEY=

# ── e-mail: the OVH mailbox ─────────────────────────────────────────────────
# Without these the API REFUSES TO START online: a sign-up whose link goes to
# a log nobody reads is what met the first demo. The From address must be
# the mailbox that signs in — OVH silently drops anything else, so the API
# refuses a mismatch too. Test by hand, errors in the open:
#   docker compose exec api python -m leka.identity.email --test you@example.com
LEKA_EMAIL_FROM=LEKA <support@leka-core.com>
LEKA_SMTP_HOST=ssl0.ovh.net
LEKA_SMTP_PORT=465
LEKA_SMTP_USE_SSL=true
LEKA_SMTP_USERNAME=support@leka-core.com
# The mailbox password: here, on the box, and nowhere else.
LEKA_SMTP_PASSWORD=

# Every link in an email is built on this. https, no trailing slash.
LEKA_WEB_URL=https://app.leka-core.com

# ── monitoring ───────────────────────────────────────────────────────────────
# Empty means off. Sentry project on the EU region.
LEKA_SENTRY_DSN=

# ── the browser contract ─────────────────────────────────────────────────────
# Staging speaks HTTPS, so the session cookie is Secure. See ADR 009.
LEKA_SESSION_COOKIE_SECURE=true
LEKA_CORS_ORIGINS=["https://app.staging.example"]
LEKA_LOG_FORMAT=json
