# Copiez ce fichier en .env, dans ce dossier, et remplissez-le.
# Le fichier .env ne quitte jamais votre ordinateur : ne le transmettez pas.

# Le Confluence lu.
# Cloud : https://<site>.atlassian.net — Data Center : l'adresse de votre Confluence.
SOURCE_URL=https://votre-site.atlassian.net
# Cloud : le mail du compte. Data Center : laissez vide.
SOURCE_EMAIL=prenom.nom@entreprise.com
# Cloud : un token API (id.atlassian.com → Sécurité → Tokens d'API).
# Data Center : un jeton d'accès personnel.
SOURCE_TOKEN=

# Le Confluence où écrire (Cloud).
TARGET_URL=https://autre-site.atlassian.net
TARGET_EMAIL=prenom.nom@exemple.com
TARGET_TOKEN=
