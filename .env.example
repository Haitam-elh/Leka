# LEKA — environment template.
#
#   cp .env.example .env
#
# .env is git-ignored and must stay that way: architecture rule 12, never a
# secret in Git. Every value below is fake and safe to commit.
#
# Two families of variables live here:
#   POSTGRES_* / REDIS_PORT  are read by docker-compose.yml (the containers)
#   LEKA_*                   are read by the API (leka/core/config.py)
# They are separate on purpose — the API can point at a managed database that
# docker-compose knows nothing about.

# ─── Containers (docker-compose.yml) ────────────────────────────────────────

# Database superuser created on first boot of the postgres container.
POSTGRES_USER=leka
# Local throwaway password. Never reuse it anywhere that matters.
POSTGRES_PASSWORD=leka
# Database created on first boot.
POSTGRES_DB=leka
# Host port for PostgreSQL. Change it if 5432 is already taken on your machine.
POSTGRES_PORT=5432
# Host port for Redis. Same idea.
REDIS_PORT=6379

# ─── API (required — it refuses to start without these) ─────────────────────

# Async driver is mandatory: postgresql+asyncpg://, not postgresql://.
# The API checks this at startup and names the problem if you get it wrong.
LEKA_DATABASE_URL=postgresql+asyncpg://leka:leka@127.0.0.1:5432/leka

# Queue backend for the background loop.
LEKA_REDIS_URL=redis://127.0.0.1:6379/0

# Signing key for anything the server hands a client. Consumed by
# leka.identity (LEKA-330). Generate a real one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LEKA_SECRET_KEY=dev-only-not-a-real-secret-change-me

# Fernet keys encrypting customers' credentials at rest. A JSON list: the
# FIRST key encrypts, all of them are tried when decrypting — which is what
# makes key rotation possible without downtime. Rotating:
#   1. put the new key first, keep the old one, deploy
#   2. re-encrypt existing rows
#   3. drop the old key in a later deploy
#
# The key below is public, it is in this file. Generate a real one per
# environment and never commit it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEKA_ENCRYPTION_KEYS=["MN3nrX7VP5Mj0SRB4G-pIPOrvlCyT-CQoBZvsQFYHss="]

# ─── API (optional — sensible defaults if omitted) ──────────────────────────

# local | ci | staging | production
LEKA_ENVIRONMENT=local
LEKA_DEBUG=false

# DEBUG | INFO | WARNING | ERROR
LEKA_LOG_LEVEL=INFO
# console for a terminal, json for a log collector.
LEKA_LOG_FORMAT=console

# Origins allowed to call the API from a browser. The Next.js dev server.
LEKA_CORS_ORIGINS=["http://localhost:3000"]

# Le cookie de session n'est envoyé qu'en HTTPS. C'est le défaut, et c'est le
# bon en production — mais le serveur de développement est en http://, donc
# le navigateur refuserait purement et simplement de le stocker : la
# connexion semblerait marcher et rien ne serait authentifié ensuite.
#
# false est réservé au développement local. L'API REFUSE de démarrer avec
# cette valeur quand LEKA_ENVIRONMENT=production.
LEKA_SESSION_COOKIE_SECURE=false

# lax | strict | none. Voir docs/adr/009-cookie-strategy.md.
LEKA_SESSION_COOKIE_SAMESITE=lax


# Connection pool. Raise on a server, leave alone on a laptop.
LEKA_DB_POOL_SIZE=5
LEKA_DB_MAX_OVERFLOW=10
# Log every SQL statement. Useful for an afternoon, unbearable for a week.
LEKA_DB_ECHO=false

# Model access. Read by leka.capabilities and nowhere else (rule 7).
# Both keys may be left empty: the platform boots and serves without a model.
#
# Which provider the gateway uses: mistral | anthropic
# Mistral is the default and Claude the fallback. Two providers from the
# start is deliberate — an abstraction validated against one implementation
# only fits that one — and keeping the European path as the default means it
# is the one exercised every day.
LEKA_LLM_PROVIDER=mistral
LEKA_ANTHROPIC_API_KEY=
LEKA_MISTRAL_API_KEY=

# ─── Web (web/.env.local) ───────────────────────────────────────────────────
# Where the browser reaches the API. NEXT_PUBLIC_ is visible to anyone who
# opens devtools — never put a secret behind that prefix.
#
# localhost, NOT 127.0.0.1, and this matters. The Next dev server serves on
# localhost:3000; a browser treats localhost and 127.0.0.1 as different
# SITES, so a SameSite=Lax session cookie set by one is not sent to the
# other. Sign-in would appear to succeed and every request after it would be
# anonymous. Same host, different ports is same-site — ports do not count.
#
# The same rule in production: app.leka-core.com and api.leka-core.com share
# the parent domain. See docs/adr/009-cookie-strategy.md.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Envoi d'e-mails ────────────────────────────────────────────────────────
# Sans rien ici, les liens de vérification et de réinitialisation s'écrivent
# dans les logs de l'API. C'est ce qui rend le développement possible sans
# aucun compte nulle part.
#
# Pour envoyer de VRAIS e-mails avec une boîte OVH :
#   LEKA_SMTP_HOST=ssl0.ovh.net
#   LEKA_SMTP_PORT=465
#   LEKA_SMTP_USERNAME=support@leka-core.com
#   LEKA_SMTP_PASSWORD=<le mot de passe de cette boîte>
#   LEKA_EMAIL_FROM=LEKA <support@leka-core.com>
#
# L'adresse d'expédition DOIT être la boîte authentifiée. OVH refuse
# d'envoyer au nom d'une autre adresse, et l'échec est silencieux : l'e-mail
# n'arrive jamais et rien ne le dit à l'utilisateur.
# Le port 465 est en SSL/TLS direct (LEKA_SMTP_USE_SSL=true, le défaut).
# Pour le port 587, mettre LEKA_SMTP_USE_SSL=false — c'est du STARTTLS.
LEKA_SMTP_HOST=
LEKA_SMTP_PORT=465
LEKA_SMTP_USERNAME=
LEKA_SMTP_PASSWORD=
LEKA_SMTP_USE_SSL=true
